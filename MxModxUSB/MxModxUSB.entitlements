<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: the Current State page's audio meter reads the MODX's USB audio input
	     (Device/ModxAudioMeter.swift). macOS still asks the user once (NSMicrophoneUsageDescription). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
