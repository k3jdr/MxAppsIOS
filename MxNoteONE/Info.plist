<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- mxnoteone:// links (Copy Link to Page, Paragraph, Section, Notebook or Pin) open here from other apps,
	     e.g. a link on a symbol or company name in MxPortMGR: page/NOTEBOOK/PAGE[?e=…&p=…], section/NOTEBOOK/SECTION,
	     notebook/NOTEBOOK (NotebookStore.openLink) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.k3jdr.MxNoteONE</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mxnoteone</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
