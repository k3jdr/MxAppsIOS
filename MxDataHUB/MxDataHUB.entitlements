<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- At launch, Start Services asks Terminal to run mxservices.py (the sandbox would hold anything the app ran itself;
	     Apple Events: macOS asks once). The sandbox and network entitlements come from the build settings. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Terminal</string>
	</array>
</dict>
</plist>
