<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Remember project folders chosen for "Open Project" (security-scoped bookmarks), so they can be
	     handed to CLion / Xcode / Finder. The sandbox, network and user-selected file entitlements come
	     from the build settings. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
