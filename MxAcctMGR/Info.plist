<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- mxportmgr://my-portfolio/CODE opens My Portfolio from the security-master account CODE
	     (MxDataHUB ▸ Portfolios ▸ Open in MxPortMGR, MxJobsWMS ▸ Window ▸ Open MxPortMGR; see Shared/AppLinks.swift) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.k3jdr.MxPortMGR</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mxportmgr</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
